---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border flex justify-center border-t py-6 sm:py-4">
    <div class="text-center text-sm">
      Copyright © 2023-2026 Zhengyi Xu. All rights reserved.
    </div>
  </div>
</footer>
