---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{
  config.features.showBackButton && (
    <div class="app-layout flex items-center justify-start">
      <LinkButton
        id="back-button"
        href={getRelativeLocaleUrl(locale, "")}
        class="focus-outline hover:text-foreground/75 -ms-2 mt-8 mb-2"
      >
        <IconChevronLeft class="inline-block size-6 rtl:rotate-180" />
        <span>{t.post.goBack}</span>
      </LinkButton>
    </div>
  )
}

<script>
  function updateGoBackUrl() {
    const backButton: HTMLAnchorElement | null =
      document.querySelector("#back-button");
    if (!backButton) return;

    const fallbackUrl = backButton.getAttribute("href") ?? "/";
    const storedBackUrl = sessionStorage.getItem("backUrl");
    if (!storedBackUrl) return;

    try {
      const backUrl = new URL(storedBackUrl, window.location.origin);

      if (backUrl.origin !== window.location.origin) {
        sessionStorage.removeItem("backUrl");
        backButton.href = fallbackUrl;
        return;
      }

      // The former paginated list lived at /posts/, /posts/2/, etc.
      // It now lives at /, /2/, etc. Migrate stale session values.
      const legacyPostsPage = backUrl.pathname.match(
        /^(.*\/)posts(?:\/(\d+))?\/?$/
      );

      if (legacyPostsPage) {
        const [, basePath, pageNumber] = legacyPostsPage;
        backUrl.pathname =
          pageNumber && pageNumber !== "1"
            ? `${basePath}${pageNumber}/`
            : basePath;
        backUrl.search = "";
        backUrl.hash = "";
      }

      const resolvedBackUrl = `${backUrl.pathname}${backUrl.search}${backUrl.hash}`;

      if (backUrl.pathname === window.location.pathname) {
        sessionStorage.removeItem("backUrl");
        backButton.href = fallbackUrl;
        return;
      }

      sessionStorage.setItem("backUrl", resolvedBackUrl);
      backButton.href = resolvedBackUrl;
    } catch {
      sessionStorage.removeItem("backUrl");
      backButton.href = fallbackUrl;
    }
  }

  document.addEventListener("astro:page-load", updateGoBackUrl);
  updateGoBackUrl();
</script>
